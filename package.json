{
  "name": "kws2100-exam",
  "version": "1.0.0",
  "description": "[![Review Assignment Due Date](https://classroom.github.com/assets/deadline-readme-button-22041afd0340ce965d47ae6ef1cefeee28c7c493a6346c4f15d667ab976d596c.svg)](https://classroom.github.com/a/XamnFLGl)",
  "main": "index.js",
  "scripts": {
    "start": "cd server && npm start",
    "test": "tsc --noEmit && prettier --check .",
    "dev": "vite",
    "build": "vite build",
    "prepare": "husky",
    "db:data:dev": "npm run db:firestation && npm run db:civildefence",
    "db:firestation": "npm run db:firestation:download && npm run db:firestation:import",
    "db:civildefence": "npm run db:civildefencedistricts:download && npm run db:civildefencedistricts:import",
    "db:firestation:download": "download --extract --out tmp https://nedlasting.geonorge.no/geonorge/Samfunnssikkerhet/Brannstasjoner/PostGIS/Samfunnssikkerhet_0000_Norge_25833_Brannstasjoner_PostGIS.zip",
    "db:firestation:import": "docker exec -i /postgis /usr/bin/psql --user postgres < tmp/Samfunnssikkerhet_0000_Norge_25833_Brannstasjoner_PostGIS.sql",
    "db:civildefencedistricts:download": "download --extract --out tmp https://nedlasting.geonorge.no/geonorge/Samfunnssikkerhet/Sivilforsvarsdistrikter/PostGIS/Samfunnssikkerhet_0000_Norge_25832_Sivilforsvarsdistrikter_PostGIS.zip",
    "db:civildefencedistricts:import": "docker exec -i /postgis /usr/bin/psql --user postgres < tmp/Samfunnssikkerhet_0000_Norge_25832_Sivilforsvarsdistrikter_PostGIS.sql",
    "postinstall": "cd server && npm install --include=dev",
    "db:heroku": "npm run db:heroku:postgis && npm run db:firestation:heroku && npm run db:civildefencedistricts:heroku",
    "db:civildefencedistricts:heroku": "npm run db:civildefencedistricts:download && psql $DATABASE_URL < tmp/Samfunnssikkerhet_0000_Norge_25832_Sivilforsvarsdistrikter_PostGIS.sql",
    "db:heroku:postgis": "echo 'create extension postgis' | psql $DATABASE_URL ",
    "db:firestation:heroku": "npm run db:firestation:download && psql $DATABASE_URL < tmp/Samfunnssikkerhet_0000_Norge_25833_Brannstasjoner_PostGIS.sql"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristiania-kws2100-2025/kws2100-exam-HananHamidMoussa.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kristiania-kws2100-2025/kws2100-exam-HananHamidMoussa/issues"
  },
  "homepage": "https://github.com/kristiania-kws2100-2025/kws2100-exam-HananHamidMoussa#readme",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "download-cli": "^1.1.1",
    "hono": "^4.7.8",
    "ol": "^10.5.0",
    "pg": "^8.15.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
